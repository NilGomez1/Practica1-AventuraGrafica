  dialogueManager: {fileID: 62072472}
  dialogoMirar:
  - "\"Me mira fijamente con sus ojos redondos... Jurar\xEDa que est\xE1 tramando algo.\""
  dialogoUsar:
  - "\xA1Ruaaaac! \xA1Busca el mando, viejo! \xA1Ruaaaac!"
  dialogoCoger:
  - "Ni hablar. Tiene el pico muy afilado y si intento agarrarlo me dejar\xE1 sin un dedo."
