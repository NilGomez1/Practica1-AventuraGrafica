  gameManager: {fileID: 858028586}
  dialogueManager: {fileID: 62072472}
  dialogoMirar:
  - "Esa esquina doblada de la alfombra es un peligro. Cualquier d\xEDa me tropiezo y me rompo la cadera."
  dialogoUsar:
  - "Voy a levantarla por si el mando se col\xF3 por debajo... Nada. Solo hay polvo acumulado."
  dialogoCoger:
  - "Ya me cost\xF3 horrores desenrollarla cuando la compr\xE9, no la voy a mover ahora."
  anim: {fileID: 0}
  boolAnimacion: isPlotting
