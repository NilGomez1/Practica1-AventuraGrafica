  dialogueManager: {fileID: 62072472}
  dialogoMirar:
  - "Ese viejo sof\xE1 de flores... Siempre se traga las monedas y las llaves."
  dialogoUsar:
  - "Voy a meter la mano entre los cojines a ver si est\xE1 el mando... \xA1Uf! Solo hay polvo y un caramelo pegajoso de menta."
  dialogoCoger:
  - "Claro, me guardar\xE9 un sof\xE1 de tres plazas en el bolsillo del pantal\xF3n."
  anim: {fileID: 0}
  boolAnimacion: isPlotting
